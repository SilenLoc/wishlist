---
import Base from "../../layouts/Base.astro";
import { getCollection, render } from "astro:content";
import { categories } from "../../categories";

export async function getStaticPaths() {
  const paths = [];
  for (const category of categories) {
    const items = await getCollection(category.slug);
    for (const item of items) {
      paths.push({
        params: { category: category.slug, slug: item.id },
        props: { item },
      });
    }
  }
  return paths;
}

const { item } = Astro.props;
const category = categories.find((c) => c.slug === Astro.params.category);
const base = import.meta.env.BASE_URL;

const heading = item.data.author
  ? item.data.title + " - " + item.data.author
  : item.data.title;
const rawDescription = (item.body ?? "")
  .replace(/^>\s*/gm, "")
  .replace(/\s+/g, " ")
  .trim();
const metaDescription =
  rawDescription.length > 160
    ? rawDescription.slice(0, 157) + "..."
    : rawDescription;

const { Content } = await render(item);
---

<Base title={heading + " | My Wishlist"} description={metaDescription}>
  <p class="breadcrumbs">
    <a href={base}>Wishlist</a> / <span>{category?.label}</span>
  </p>
  <h1>{heading}</h1>
  <div class="item-meta">
    <span class="chip"><strong>Category:</strong> {category?.label}</span>
    <span class="chip"><strong>Price:</strong> {item.data.price}</span>
  </div>
  {item.data.links.length > 0 && (
    <div class="buy">
      <h2>Where to buy</h2>
      <ul class="buy-links">
        {item.data.links.map((link) => (
          <li>
            <a class="btn" href={link.url} rel="noopener">{link.label}</a>
          </li>
        ))}
      </ul>
    </div>
  )}
  <div class="description">
    <Content />
  </div>
</Base>
